{
  "name": "telegram-reader",
  "version": "1.4.0",
  "description": "Read Telegram channel posts via MTProto as flat rows with text and lightweight photo previews — built for LLM agents, analytics, and trading-signal backtests with backtest-kit",
  "keywords": [
    "telegram",
    "mtproto",
    "gramjs",
    "scraper",
    "channel",
    "userbot",
    "backtest",
    "backtest-kit",
    "trading",
    "llm"
  ],
  "homepage": "https://backtest-kit.github.io/documents/article_08_ai_liquidity_harvesting.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tripolskypetr/backtest-kit.git"
  },
  "author": "Petr Tripolsky <tripolskypetr@gmail.com>",
  "scripts": {
    "build": "rollup -c",
    "repl": "dotenv -e .env -- npm run build && node -e \"require('./build/index.cjs')\" --interactive"
  },
  "main": "build/index.cjs",
  "module": "build/index.mjs",
  "source": "src/index.ts",
  "types": "./types.d.ts",
  "exports": {
    "require": "./build/index.cjs",
    "types": "./types.d.ts",
    "import": "./build/index.mjs",
    "default": "./build/index.cjs"
  },
  "peerDependencies": {
    "di-kit": "^1.1.1",
    "functools-kit": "^5.0.0",
    "get-moment-stamp": "^3.0.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.3",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "di-kit": "1.1.1",
    "functools-kit": "5.0.0",
    "get-moment-stamp": "3.0.0",
    "qrcode-terminal": "0.12.0",
    "sharp": "0.35.3",
    "telegram": "2.26.22",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-typescript": "11.1.6",
    "@types/node": "22.9.0",
    "dotenv-cli": "11.0.0",
    "rollup": "3.29.5",
    "rollup-plugin-dts": "6.1.1",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "ts-morph": "27.0.2",
    "tslib": "2.7.0",
    "typescript": "5.9.3"
  }
}
